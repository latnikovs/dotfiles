" =========================
" BASIC VIM BEHAVIOR
" =========================

set number          " show line numbers
set relativenumber  " relative line numbers (great for motions)
set ignorecase
set smartcase
set incsearch
set hlsearch
set scrolloff=5
set visualbell
set noerrorbells
set history=1000
set ideajoin

" gcc → comment/uncomment current line
" gc in visual mode → comment selection
set commentary

" =========================
" LEADER KEY
" =========================

let mapleader=" "

" =========================
" BETTER ESCAPE (great habit)
" =========================

inoremap jj <Esc>

" =========================
" CLIPBOARD INTEGRATION
" =========================

set clipboard+=unnamedplus

" =========================
" USEFUL KEYMAPS
" =========================

" Save file
nnoremap <leader>w :w<CR>

" Quit
nnoremap <leader>q :q<CR>

" IntelliJ actions (IdeaVim magic)
" Go to definition
nnoremap gd :action GotoDeclaration<CR>

" Find usages
nnoremap gr :action FindUsages<CR>

" Rename symbol (refactor)
nnoremap <leader>r :action RenameElement<CR>

" Format code
nnoremap <leader>f :action ReformatCode<CR>

" Open file search
nnoremap <leader>p :action SearchEverywhere<CR>

" Clear search highlighting
nnoremap <leader>h :noh<CR>

" Open Terminal
nmap <Leader>t :action ActivateTerminalToolWindow<CR>
